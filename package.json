{
    "name": "Knowte",
    "desktopName": "Knowte",
    "version": "3.1.0",
    "versionSuffix": "",
    "copyright": "Copyright Digimezzo Ⓒ 2013 - 2026",
    "description": "A note taking application that allows you to quickly and easily organize and find your notes",
    "homepage": "https://github.com/digimezzo/knowte",
    "author": {
        "name": "Digimezzo",
        "email": "digimezzo@outlook.com"
    },
    "keywords": [
        "angular",
        "electron",
        "typescript",
        "sass"
    ],
    "main": "main.js",
    "private": true,
    "scripts": {
        "postinstall": "npm run postinstall:electron && npx electron-builder install-app-deps",
        "postinstall:web": "node postinstall-web",
        "postinstall:electron": "node postinstall",
        "ng": "ng",
        "start": "npm run postinstall:electron && npm-run-all -p ng:serve electron:serve",
        "build": "npm run postinstall:electron && npm run electron:serve-tsc && ng build",
        "build:dev": "npm run build -- -c dev",
        "build:prod": "npm run build -- -c production",
        "ng:serve": "ng serve",
        "ng:serve:web": "npm run postinstall:web && ng serve -o",
        "electron:serve-tsc": "tsc -p tsconfig-serve.json",
        "electron:serve": "wait-on http-get://localhost:4200/ && npm run electron:serve-tsc && electron . --serve",
        "electron:local": "npm run build:prod && electron .",
        "electron:linux": "npm run build:prod && npx electron-builder build --linux --config electron-builder.config.js",
        "electron:windows": "npm run build:prod && npx electron-builder build --windows --config electron-builder.config.js",
        "electron:mac": "npm run build:prod && npx electron-builder build --mac --config electron-builder.config.js",
        "test": "npx jest --verbose"
    },
    "overrides": {
        "ngx-markdown": {
            "mermaid": "$mermaid"
        }
    },
    "dependencies": {
        "@angular/animations": "^21.2.26",
        "@angular/cdk": "^21.0.0",
        "@angular/material": "^21.0.0",
        "@electron/remote": "^2.1.3",
        "@fortawesome/fontawesome-free": "^6.3.0",
        "angular-split": "14.1.0",
        "archiver": "^5.3.1",
        "crypto-js": "^4.1.1",
        "dompurify": "^3.3.3",
        "electron-localshortcut": "^3.2.1",
        "electron-log": "4.4.8",
        "electron-window-state": "^5.0.3",
        "extract-zip": "^2.0.1",
        "fs-extra": "10.1.0",
        "line-awesome": "^1.3.0",
        "lokijs": "^1.5.12",
        "marked": "^17.0.0",
        "material-design-icons": "^3.0.1",
        "mermaid": "^12.2.0",
        "moment": "^2.27.0",
        "nanoid": "^4.0.0",
        "ngx-markdown": "^21.0.0",
        "prismjs": "^1.30.0",
        "quill": "^1.3.7",
        "quill-blot-formatter": "^1.0.5",
        "sanitize-filename": "1.6.3",
        "tinycolor2": "^1.4.2",
        "tslib": "^2.4.1"
    },
    "devDependencies": {
        "@angular-builders/custom-webpack": "^21.0.0",
        "@angular/build": "^21.2.30",
        "@angular/cli": "21.2.30",
        "@angular/common": "21.2.26",
        "@angular/compiler": "21.2.26",
        "@angular/compiler-cli": "21.2.26",
        "@angular/core": "21.2.26",
        "@angular/forms": "21.2.26",
        "@angular/language-service": "21.2.26",
        "@angular/platform-browser": "21.2.26",
        "@angular/platform-browser-dynamic": "21.2.26",
        "@angular/router": "21.2.26",
        "@ngx-translate/core": "15.0.0",
        "@ngx-translate/http-loader": "8.0.0",
        "@types/d3-dispatch": "3.0.1",
        "@types/jest": "30.0.0",
        "@types/node": "^22.20.5",
        "codelyzer": "^6.0.0",
        "core-js": "2.6.1",
        "electron": "^43.0.0",
        "electron-builder": "26.3.6",
        "electron-reload": "1.5.0",
        "jest": "^30.0.0",
        "jest-environment-jsdom": "^30.5.2",
        "jest-preset-angular": "^16.0.0",
        "npm-run-all": "4.1.5",
        "npx": "10.2.0",
        "rxjs": "^7.0.0",
        "ts-jest": "^29.0.0",
        "ts-node": "10.9.1",
        "tslint": "~6.1.0",
        "type-fest": "3.13.1",
        "typemoq": "^2.1.0",
        "typescript": "~5.9.3",
        "wait-on": "3.2.0",
        "webdriver-manager": "12.1.1",
        "zone.js": "~0.15.1"
    }
}
